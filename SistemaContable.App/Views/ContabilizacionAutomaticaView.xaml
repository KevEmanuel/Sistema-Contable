<UserControl x:Class="SistemaContableDTE.Views.ContabilizacionAutomaticaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:ContabilizacionAutomaticaViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <Grid Margin="0,0,0,20">
                <TextBlock Text="Contabilización automática de DTE"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <Button Content="Volver al panel"
                        Width="170"
                        Height="32"
                        HorizontalAlignment="Right"
                        Click="VolverAlPanelPrincipal_Click" />
            </Grid>

            <GroupBox Header="Generar partida contable"
                      Margin="0,0,0,15">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">
                        <TextBlock Text="DTE validado pendiente" />
                        <ComboBox ItemsSource="{Binding DtesPendientes}"
                                  SelectedItem="{Binding DocumentoSeleccionado}"
                                  DisplayMemberPath="CodigoGeneracion"
                                  Height="28"
                                  Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="Regla contable" />
                        <ComboBox ItemsSource="{Binding Reglas}"
                                  SelectedItem="{Binding ReglaSeleccionada}"
                                  DisplayMemberPath="Nombre"
                                  Height="28"
                                  Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,12,0">
                        <TextBlock Text="Período contable" />
                        <ComboBox ItemsSource="{Binding Periodos}"
                                  SelectedItem="{Binding PeriodoSeleccionado}"
                                  DisplayMemberPath="Nombre"
                                  Height="28"
                                  Margin="0,5,0,0" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Generar partida"
                            Height="30"
                            VerticalAlignment="Bottom"
                            Command="{Binding ContabilizarCommand}" />
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding Mensaje}"
                       Foreground="DarkRed"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <GroupBox Header="Líneas que aplicará la regla">
                <DataGrid ItemsSource="{Binding LineasRegla}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Height="220"
                          Margin="15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Orden"
                                            Binding="{Binding Orden}"
                                            Width="70" />
                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding CuentaContable.Codigo}"
                                            Width="120" />
                        <DataGridTextColumn Header="Cuenta"
                                            Binding="{Binding CuentaContable.Nombre}"
                                            Width="*" />
                        <DataGridTextColumn Header="Lado"
                                            Binding="{Binding Lado}"
                                            Width="100" />
                        <DataGridTextColumn Header="Fórmula"
                                            Binding="{Binding Formula}"
                                            Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Button Content="Actualizar datos"
                    Width="150"
                    Height="30"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Command="{Binding CargarCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
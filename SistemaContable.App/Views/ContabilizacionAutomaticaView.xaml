<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels" xmlns:model="clr-namespace:SistemaContableDTE.Models" x:Class="SistemaContableDTE.Views.ContabilizacionAutomaticaView">

    <UserControl.DataContext>
        <vm:ContabilizacionAutomaticaViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#30435F"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="White" BorderBrush="#E1E8F3" BorderThickness="1" CornerRadius="14" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#163A63" BlurRadius="14" ShadowDepth="2" Opacity="0.09"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="17" TextElement.Foreground="#204A76"/>
                            <ContentPresenter Grid.Row="1" ContentSource="Content" Margin="0,16,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Background" Value="#FBFCFE"/>
        <Setter Property="Foreground" Value="#243B53"/>
        <Setter Property="BorderBrush" Value="#CBD8E6"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="Background" Value="#FBFCFE"/>
        <Setter Property="Foreground" Value="#243B53"/>
        <Setter Property="BorderBrush" Value="#CBD8E6"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="Background" Value="#EAF1FB"/>
        <Setter Property="Foreground" Value="#285AA2"/>
        <Setter Property="BorderBrush" Value="#D6E3F4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.50"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#285AA2"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#285AA2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1E477F"/>
                <Setter Property="BorderBrush" Value="#1E477F"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DCE9FA"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#FDEBEB"/>
        <Setter Property="Foreground" Value="#B42318"/>
        <Setter Property="BorderBrush" Value="#F8C8C8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FBD8D8"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#22538F"/>
        <Setter Property="BorderBrush" Value="#CEDDF0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EDF4FD"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E8F0FB"/>
        <Setter Property="Foreground" Value="#214B77"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="BorderBrush" Value="#D7E3F1"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Foreground" Value="#243B53"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DDEBFB"/>
                <Setter Property="Foreground" Value="#153D6B"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D8E4F1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F5F8FC"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF7"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
    </Style>
    <Style x:Key="NoticeStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#245B91"/>
        <Setter Property="Background" Value="#EAF3FD"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Mensaje}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Mensaje}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</UserControl.Resources><!-- Horizontal scrolling is disabled at page level; DataGrid tables scroll independently. --><ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F4F7FB" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,32" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Vertical" Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="DTE a libros contables" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0F243F"/>
                <TextBlock Text="Configura tipos de DTE, prepara borradores y confirma partidas contables." Foreground="#637A94" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Button Content="Volver al panel" Width="150" Height="38" HorizontalAlignment="Right" Click="VolverAlPanelPrincipal_Click" Style="{StaticResource OutlineButtonStyle}" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="Configura las cuentas y la operación para cada código de tipo DTE. Los borradores generados siempre quedan pendientes de revisión." TextWrapping="Wrap" Margin="0,0,0,18" Foreground="#58708B" FontSize="13"/>

            <GroupBox Header="1. Configuración por tipo de DTE" Margin="0,0,0,15">
                <StackPanel Margin="0">
                    <DataGrid ItemsSource="{Binding Configuraciones}" SelectedItem="{Binding ConfiguracionSeleccionada}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="144" Margin="0,0,0,12" ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código DTE" Binding="{Binding TipoDte}" Width="110"/>
                            <DataGridTextColumn Header="Operación configurada" Binding="{Binding OperacionDescripcion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Código de tipo DTE (1 a 5 caracteres)" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding TiposDteDisponibles}" Text="{Binding TipoDteCodigo, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsReadOnly="{Binding CodigoDteBloqueado}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Clasificación"/>
                            <ComboBox SelectedValue="{Binding OperacionSeleccionada}" SelectedValuePath="Tag" Margin="0,4,0,0">
                                <ComboBoxItem Content="Venta" Tag="{x:Static model:OperacionConfiguracionDte.Venta}"/>
                                <ComboBoxItem Content="Compra" Tag="{x:Static model:OperacionConfiguracionDte.Compra}"/>
                                <ComboBoxItem Content="Revisión manual (sin generar partida)" Tag="{x:Static model:OperacionConfiguracionDte.RevisionManual}"/>
                                <ComboBoxItem Content="Automática por rol (solo tipos 01 y 03)" Tag="{x:Static model:OperacionConfiguracionDte.PorRolEmpresa}"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nueva configuración" Height="38" Padding="10,0" VerticalAlignment="Bottom" Command="{Binding NuevaConfiguracionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Clientes / cuentas por cobrar" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding Cuentas}" SelectedItem="{Binding CuentaClientesSeleccionada}" DisplayMemberPath="Etiqueta" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                            <TextBlock Text="Ventas"/>
                            <ComboBox ItemsSource="{Binding Cuentas}" SelectedItem="{Binding CuentaVentasSeleccionada}" DisplayMemberPath="Etiqueta" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="IVA débito fiscal (si aplica)" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding Cuentas}" SelectedItem="{Binding CuentaIvaDebitoSeleccionada}" DisplayMemberPath="Etiqueta" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Proveedores / cuentas por pagar" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding Cuentas}" SelectedItem="{Binding CuentaProveedoresSeleccionada}" DisplayMemberPath="Etiqueta" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,10">
                            <TextBlock Text="Compras / gastos"/>
                            <ComboBox ItemsSource="{Binding Cuentas}" SelectedItem="{Binding CuentaComprasSeleccionada}" DisplayMemberPath="Etiqueta" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="IVA crédito fiscal (si aplica)" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding Cuentas}" SelectedItem="{Binding CuentaIvaAcreditableSeleccionada}" DisplayMemberPath="Etiqueta" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Los códigos no incluidos en el catálogo también se pueden escribir aquí. La clasificación por rol conserva el comportamiento anterior para Factura (01) y Crédito fiscal (03); los demás tipos deben configurarse como compra, venta o revisión manual." Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Guardar configuración del tipo DTE" Height="38" HorizontalAlignment="Right" Command="{Binding GuardarConfiguracionCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. Preparar partida desde un DTE validado" Margin="0,0,0,15">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="DTE validado pendiente de contabilizar" TextWrapping="Wrap"/>
                        <ComboBox ItemsSource="{Binding DtesPendientes}" SelectedItem="{Binding DocumentoSeleccionado}" Margin="0,4,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding TipoDte, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding NumeroControl, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding FechaEmision, StringFormat=d, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding OperacionContableDescripcion, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Período contable"/>
                        <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSeleccionado}" DisplayMemberPath="Nombre" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Generar borrador seleccionado" Height="38" Padding="12,0" Margin="0,0,8,0" Command="{Binding GenerarBorradorCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Preparar todos los DTE pendientes" Height="38" Padding="12,0" Command="{Binding GenerarBorradoresTodosCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource NoticeStyle}"/>

            <GroupBox Header="3. Revisar y confirmar borrador" Margin="0,0,0,15">
                <StackPanel Margin="0">
                    <DataGrid ItemsSource="{Binding Borradores}" SelectedItem="{Binding BorradorSeleccionado}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="176" ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Partida" Binding="{Binding NumeroPartida}" Width="75"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=d}" Width="100"/>
                            <DataGridTextColumn Header="DTE" Binding="{Binding DocumentoDte.TipoDte}" Width="70"/>
                            <DataGridTextColumn Header="Número de control" Binding="{Binding DocumentoDte.NumeroControl}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Detalle de la partida seleccionada" FontWeight="Bold" Margin="0,10,0,5" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding BorradorSeleccionado.Detalles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="156" ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cuenta" Binding="{Binding CuentaContable.Etiqueta}" Width="*"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                            <DataGridTextColumn Header="Debe" Binding="{Binding Debe, StringFormat=N2}" Width="120"/>
                            <DataGridTextColumn Header="Haber" Binding="{Binding Haber, StringFormat=N2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Eliminar borrador" Height="38" Margin="0,0,8,0" Padding="12,0" Command="{Binding EliminarBorradorCommand}" Style="{StaticResource DangerButtonStyle}"/>
                        <Button Content="Confirmar y agregar a libros" Height="38" Padding="12,0" Command="{Binding ContabilizarBorradorCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <Button Content="Actualizar datos" Width="170" Height="38" HorizontalAlignment="Right" Command="{Binding CargarCommand}" Style="{StaticResource OutlineButtonStyle}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
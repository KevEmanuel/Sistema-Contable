<UserControl x:Class="SistemaContableDTE.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:LoginViewModel />
    </UserControl.DataContext>

    <Grid Background="#F5F7FA">
        <Border Width="420"
                Padding="35"
                Background="White"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Sistema Contable DTE"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Iniciar sesión"
                           FontSize="18"
                           Margin="0,8,0,25"
                           HorizontalAlignment="Center"
                           Foreground="DimGray" />

                <TextBlock Text="Correo electrónico" />
                <TextBox Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         Margin="0,5,0,15" />

                <TextBlock Text="Contraseña" />
                <PasswordBox x:Name="Contrasena"
                             Height="30"
                             Margin="0,5,0,20" />

                <TextBlock Text="{Binding Mensaje}"
                           Foreground="DarkRed"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Button Content="Iniciar sesión"
                        Height="35"
                        Click="IniciarSesion_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
<UserControl x:Class="SistemaContableDTE.Views.LibroIvaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:LibroIvaViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,20">
            <TextBlock Text="Libro de IVA"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <Button Content="Volver al panel"
                    Width="170"
                    Height="32"
                    HorizontalAlignment="Right"
                    Click="VolverAlPanelPrincipal_Click" />
        </Grid>

        <GroupBox Grid.Row="1"
                  Header="Generar registro desde DTE validado"
                  Margin="0,0,0,15">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Text="DTE validado" />
                    <ComboBox ItemsSource="{Binding DocumentosValidados}"
                              SelectedItem="{Binding DocumentoSeleccionado}"
                              DisplayMemberPath="CodigoGeneracion"
                              Height="28"
                              Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">
                    <TextBlock Text="Período contable" />
                    <ComboBox ItemsSource="{Binding Periodos}"
                              SelectedItem="{Binding PeriodoSeleccionado}"
                              DisplayMemberPath="Nombre"
                              Height="28"
                              Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">
                    <TextBlock Text="Tipo de libro" />
                    <ComboBox ItemsSource="{Binding TiposLibro}"
                              SelectedItem="{Binding TipoLibroSeleccionado}"
                              Height="28"
                              Margin="0,5,0,0" />
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Generar registro"
                        Height="30"
                        VerticalAlignment="Bottom"
                        Command="{Binding GenerarCommand}" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2"
              Margin="0,0,0,10">
            <TextBlock Text="{Binding Mensaje}"
                       Foreground="DarkRed"
                       TextWrapping="Wrap" />

            <Button Content="Actualizar"
                    Width="120"
                    Height="28"
                    HorizontalAlignment="Right"
                    Command="{Binding CargarCommand}" />
        </Grid>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Registros}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding FechaRegistro,
                                                      StringFormat=d}"
                                    Width="100" />
                <DataGridTextColumn Header="Código DTE"
                                    Binding="{Binding DocumentoDte.CodigoGeneracion}"
                                    Width="*" />
                <DataGridTextColumn Header="Libro"
                                    Binding="{Binding TipoLibro}"
                                    Width="160" />
                <DataGridTextColumn Header="Base gravada"
                                    Binding="{Binding BaseGravada,
                                                      StringFormat=N2}"
                                    Width="120" />
                <DataGridTextColumn Header="Crédito fiscal"
                                    Binding="{Binding CreditoFiscal,
                                                      StringFormat=N2}"
                                    Width="120" />
                <DataGridTextColumn Header="Débito fiscal"
                                    Binding="{Binding DebitoFiscal,
                                                      StringFormat=N2}"
                                    Width="120" />
                <DataGridTextColumn Header="Total"
                                    Binding="{Binding TotalOperacion,
                                                      StringFormat=N2}"
                                    Width="120" />
                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Estado}"
                                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

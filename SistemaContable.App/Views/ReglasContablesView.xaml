<UserControl x:Class="SistemaContableDTE.Views.ReglasContablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:ReglasContablesViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <Grid Margin="0,0,0,20">
                <TextBlock Text="Reglas contables"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="Volver al panel"
                        Width="170"
                        Height="32"
                        HorizontalAlignment="Right"
                        Click="VolverAlPanelPrincipal_Click"/>
            </Grid>

            <GroupBox Header="Nueva regla contable"
                      Margin="0,0,0,15">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,12,12">
                        <TextBlock Text="Nombre de la regla *"/>
                        <TextBox Text="{Binding NombreRegla,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,12,12">
                        <TextBlock Text="Aplicar a tipo de DTE"/>
                        <ComboBox ItemsSource="{Binding TiposDte}"
                                  SelectedItem="{Binding TipoDteSeleccionado}"
                                  DisplayMemberPath="Descripcion"
                                 Height="28"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,12">
                        <TextBlock Text="Rol de empresa"/>
                        <ComboBox ItemsSource="{Binding RolesEmpresa}"
                                  SelectedValuePath="Valor"
                                  DisplayMemberPath="Descripcion"
                                  SelectedValue="{Binding RolEmpresaSeleccionado}"
                                  Height="28"
                                  Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,12,12">
                        <TextBlock Text="Vigencia desde"/>
                        <DatePicker SelectedDate="{Binding VigenciaDesde}"
                                    Height="28"
                                    Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,12,12">
                        <TextBlock Text="Vigencia hasta"/>
                        <DatePicker SelectedDate="{Binding VigenciaHasta}"
                                    Height="28"
                                    Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Bottom">
                        <Button Content="Crear regla"
                                Height="30"
                                Command="{Binding CrearReglaCommand}"/>
                        <Button Content="Actualizar regla seleccionada"
                                Height="30"
                                Margin="0,6,0,0"
                                Command="{Binding ActualizarReglaCommand}"/>
                        <Button Content="Eliminar regla seleccionada"
                                Height="30"
                                Margin="0,6,0,0"
                                Command="{Binding EliminarReglaCommand}"/>
                    </StackPanel>

                    <GroupBox Grid.Row="2"
                              Grid.ColumnSpan="3"
                              Header="Condiciones adicionales"
                              Margin="0,0,0,5">
                        <StackPanel Margin="10">
                            <TextBlock Text="Agrega criterios por importe. Si agregas varios, todos deben cumplirse para aplicar la regla."
                                       Foreground="DimGray"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,6">
                                <Button Content="Agregar condición"
                                        Height="28"
                                        Padding="10,0"
                                        Margin="0,0,6,0"
                                        Command="{Binding AgregarCondicionCommand}"/>
                                <Button Content="Quitar seleccionada"
                                        Height="28"
                                        Padding="10,0"
                                        Command="{Binding QuitarCondicionCommand}"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Condiciones}"
                                      SelectedItem="{Binding CondicionSeleccionada}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="False"
                                      Height="125"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Importe"
                                                            Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Campos}"
                                                          SelectedValuePath="Valor"
                                                          DisplayMemberPath="Descripcion"
                                                          SelectedValue="{Binding Campo,
                                                                                  UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Comparación"
                                                            Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Operadores}"
                                                          SelectedValuePath="Valor"
                                                          DisplayMemberPath="Descripcion"
                                                          SelectedValue="{Binding Operador,
                                                                                  UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Valor"
                                                            Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Valor,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0"
                                                         Padding="3"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Vista previa de la condición generada"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CondicionJsonVistaPrevia, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="52"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding Mensaje}"
                       Foreground="DarkRed"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <GroupBox Header="Reglas registradas"
                      Margin="0,0,0,15">
                <DockPanel Margin="15">
                    <Button DockPanel.Dock="Top"
                            Content="Actualizar lista"
                            Width="140"
                            Height="28"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10"
                            Command="{Binding CargarCommand}"/>

                    <DataGrid ItemsSource="{Binding Reglas}"
                              SelectedItem="{Binding ReglaSeleccionada,
                                                     Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="DTE"
                                                Binding="{Binding TipoDte}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Rol"
                                                Binding="{Binding RolEmpresa}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Versión"
                                                Binding="{Binding Version}"
                                                Width="75"/>
                            <DataGridTextColumn Header="Vigencia"
                                                Binding="{Binding VigenciDesde,
                                                                  StringFormat=d}"
                                                Width="100"/>
                            <DataGridCheckBoxColumn Header="Activa"
                                                    Binding="{Binding Activa}"
                                                    Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Cuentas de la regla seleccionada">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Cuenta contable"/>
                            <ComboBox ItemsSource="{Binding CuentasCatalogo}"
                                      SelectedItem="{Binding CuentaSeleccionada}"
                                      DisplayMemberPath="Nombre"
                                      Height="28"
                                      Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Lado"/>
                            <ComboBox ItemsSource="{Binding LadosContables}"
                                      SelectedItem="{Binding LadoSeleccionado}"
                                      Height="28"
                                      Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Importe de la línea"/>
                            <ComboBox ItemsSource="{Binding FormulasContables}"
                                      SelectedItem="{Binding FormulaSeleccionada}"
                                      DisplayMemberPath="Descripcion"
                                      Height="28"
                                      Margin="0,5,0,0"/>
                            <TextBox Text="{Binding ImporteFijo,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding FormulaSeleccionada.EsImporteFijo}"
                                     ToolTip="Completa este campo solo si seleccionas Importe fijo."
                                     Height="28"
                                     Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <Button Content="Agregar línea"
                                    Height="28"
                                    Margin="0,20,0,6"
                                    Command="{Binding AgregarCuentaCommand}"/>

                            <Button Content="Activar / Desactivar regla"
                                    Height="28"
                                    Command="{Binding CambiarEstadoCommand}"/>

                            <Button Content="Actualizar línea seleccionada"
                                    Height="28"
                                    Margin="0,6,0,0"
                                    Command="{Binding ActualizarCuentaCommand}"/>
                            <Button Content="Eliminar línea seleccionada"
                                    Height="28"
                                    Margin="0,6,0,0"
                                    Command="{Binding EliminarCuentaCommand}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LineasRegla}"
                              SelectedItem="{Binding LineaReglaSeleccionada}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Orden"
                                                Binding="{Binding Orden}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding CuentaContable.Codigo}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Cuenta"
                                                Binding="{Binding CuentaContable.Nombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Lado"
                                                Binding="{Binding Lado}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Fórmula"
                                                Binding="{Binding FormulaDescripcion}"
                                                Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
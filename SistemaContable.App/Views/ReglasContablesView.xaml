<UserControl x:Class="SistemaContableDTE.Views.ReglasContablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:ReglasContablesViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <Grid Margin="0,0,0,20">
                <TextBlock Text="Reglas contables"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="Volver al panel"
                        Width="170"
                        Height="32"
                        HorizontalAlignment="Right"
                        Click="VolverAlPanelPrincipal_Click"/>
            </Grid>

            <GroupBox Header="Nueva regla contable"
                      Margin="0,0,0,15">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,12,12">
                        <TextBlock Text="Nombre de la regla *"/>
                        <TextBox Text="{Binding NombreRegla,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,12,12">
                        <TextBlock Text="Tipo DTE"/>
                        <TextBox Text="{Binding TipoDte,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,12">
                        <TextBlock Text="Rol de empresa"/>
                        <ComboBox ItemsSource="{Binding RolesEmpresa}"
                                  SelectedItem="{Binding RolEmpresaSeleccionado}"
                                  Height="28"
                                  Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,12,12">
                        <TextBlock Text="Vigencia desde"/>
                        <DatePicker SelectedDate="{Binding VigenciaDesde}"
                                    Height="28"
                                    Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,12,12">
                        <TextBlock Text="Vigencia hasta"/>
                        <DatePicker SelectedDate="{Binding VigenciaHasta}"
                                    Height="28"
                                    Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="Crear regla"
                            Height="30"
                            VerticalAlignment="Bottom"
                            Command="{Binding CrearReglaCommand}"/>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="3">
                        <TextBlock Text="Condición JSON *"/>
                        <TextBox Text="{Binding CondicionJson,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="55"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding Mensaje}"
                       Foreground="DarkRed"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <GroupBox Header="Reglas registradas"
                      Margin="0,0,0,15">
                <DockPanel Margin="15">
                    <Button DockPanel.Dock="Top"
                            Content="Actualizar lista"
                            Width="140"
                            Height="28"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10"
                            Command="{Binding CargarCommand}"/>

                    <DataGrid ItemsSource="{Binding Reglas}"
                              SelectedItem="{Binding ReglaSeleccionada,
                                                     Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="DTE"
                                                Binding="{Binding TipoDte}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Rol"
                                                Binding="{Binding RolEmpresa}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Versión"
                                                Binding="{Binding Version}"
                                                Width="75"/>
                            <DataGridTextColumn Header="Vigencia"
                                                Binding="{Binding VigenciDesde,
                                                                  StringFormat=d}"
                                                Width="100"/>
                            <DataGridCheckBoxColumn Header="Activa"
                                                    Binding="{Binding Activa}"
                                                    Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Cuentas de la regla seleccionada">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Cuenta contable"/>
                            <ComboBox ItemsSource="{Binding CuentasCatalogo}"
                                      SelectedItem="{Binding CuentaSeleccionada}"
                                      DisplayMemberPath="Nombre"
                                      Height="28"
                                      Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Lado"/>
                            <ComboBox ItemsSource="{Binding LadosContables}"
                                      SelectedItem="{Binding LadoSeleccionado}"
                                      Height="28"
                                      Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Fórmula o importe"/>
                            <TextBox Text="{Binding Formula,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <Button Content="Agregar línea"
                                    Height="28"
                                    Margin="0,20,0,6"
                                    Command="{Binding AgregarCuentaCommand}"/>

                            <Button Content="Activar / Desactivar regla"
                                    Height="28"
                                    Command="{Binding CambiarEstadoCommand}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LineasRegla}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Orden"
                                                Binding="{Binding Orden}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding CuentaContable.Codigo}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Cuenta"
                                                Binding="{Binding CuentaContable.Nombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Lado"
                                                Binding="{Binding Lado}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Fórmula"
                                                Binding="{Binding Formula}"
                                                Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
<UserControl x:Class="SistemaContableDTE.Views.CatalogoCuentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:CatalogoCuentasViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- Tarjetas / secciones -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#17365D"
                                      BlurRadius="14"
                                      ShadowDepth="2"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiquetas -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#243B53"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- Botón volver -->
        <Style x:Key="TopActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="BorderBrush" Value="#C9D8EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TopBtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopBtnBorder" Property="Background" Value="#EDF4FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TopBtnBorder" Property="Background" Value="#DCEBFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón principal -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#285AA2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#285AA2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1F4E79"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#1F4E79"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#17365D"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#17365D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#EAF1FB"/>
            <Setter Property="Foreground" Value="#214D85"/>
            <Setter Property="BorderBrush" Value="#D3E2F5"/>
        </Style>

        <!-- Botón advertencia -->
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FFF4DB"/>
            <Setter Property="Foreground" Value="#9A6700"/>
            <Setter Property="BorderBrush" Value="#F2D28B"/>
        </Style>

        <!-- Botón peligro -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FEECEC"/>
            <Setter Property="Foreground" Value="#B42318"/>
            <Setter Property="BorderBrush" Value="#F5B5B0"/>
        </Style>

        <!-- Encabezado de DataGrid -->
        <Style x:Key="ModernDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1FB"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="#D8E4F1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Filas de DataGrid -->
        <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#EDF2F7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFA"/>
                    <Setter Property="Foreground" Value="#17365D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="30,26,30,20">
            <TextBlock Text="Catálogo de cuentas contables"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"/>

            <Button Content="Volver al panel"
                    Style="{StaticResource TopActionButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="VolverAlPanelPrincipal_Click"/>
        </Grid>

        <!-- Formulario -->
        <Border Grid.Row="1"
                Style="{StaticResource SectionCardStyle}"
                Margin="30,0,30,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Text="Nueva cuenta contable"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           Margin="0,0,0,18"/>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,34,14,16">
                    <TextBlock Text="Código *"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,34,14,16">
                    <TextBlock Text="Nombre *"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,34,0,16">
                    <TextBlock Text="Tipo *"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding TiposCuenta}"
                              SelectedItem="{Binding TipoCuenta}"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,14,0">
                    <TextBlock Text="Cuenta padre (opcional)"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Cuentas}"
                              SelectedItem="{Binding CuentaPadreSeleccionada}"
                              DisplayMemberPath="Nombre"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="2">
                    <CheckBox Content="Permite movimientos"
                              IsChecked="{Binding PermiteMovimientos}"
                              Margin="0,2,0,12"
                              Foreground="#243B53"
                              FontWeight="SemiBold"/>

                    <Button Content="Guardar nueva"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding GuardarCommand}"/>

                    <Button Content="Actualizar seleccionada"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ActualizarCommand}"/>

                    <Button Content="Activar / Desactivar"
                            Style="{StaticResource WarningButtonStyle}"
                            Command="{Binding CambiarEstadoCommand}"/>

                    <Button Content="Eliminar seleccionada"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="0,0,0,0"
                            Command="{Binding EliminarCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mensaje -->
        <Border Grid.Row="2"
                Margin="30,0,30,12"
                Padding="14,10"
                Background="#FFF7ED"
                BorderBrush="#FED7AA"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock Text="{Binding Mensaje}"
                       Foreground="#B45309"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Tabla -->
        <Border Grid.Row="3"
                Style="{StaticResource SectionCardStyle}"
                Margin="30,0,30,30"
                Padding="0">
            <DataGrid ItemsSource="{Binding Cuentas}"
                      SelectedItem="{Binding CuentaSeleccionada, Mode=TwoWay}"
                      SelectionMode="Single"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                      RowStyle="{StaticResource ModernDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código"
                                        Binding="{Binding Codigo}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding Nombre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Tipo"
                                        Binding="{Binding TipoCuenta}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Nivel"
                                        Binding="{Binding Nivel}"
                                        Width="80"/>

                    <DataGridCheckBoxColumn Header="Movimientos"
                                            Binding="{Binding PermiteMovimientos}"
                                            Width="110"/>

                    <DataGridCheckBoxColumn Header="Activa"
                                            Binding="{Binding Activa}"
                                            Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
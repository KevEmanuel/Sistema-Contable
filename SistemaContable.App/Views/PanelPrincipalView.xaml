<UserControl x:Class="SistemaContableDTE.Views.PanelPrincipalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:PanelPrincipalViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="ModuleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F1F8"/>
                    <Setter Property="BorderBrush" Value="#1F4E79"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1F4E79">
            <Grid Margin="25,0">
                <TextBlock Text="Sistema Contable DTE"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding NombreUsuario}"
                               Foreground="White"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CorreoUsuario}"
                               Foreground="#D9EAF7"
                               FontSize="12"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35">
                <TextBlock Text="{Binding MensajeBienvenida}"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="Acceda a las tareas disponibles en cada módulo."
                           Margin="0,8,0,22"
                           Foreground="DimGray"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ModuleCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Carga de DTE"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Importación y revisión de documentos tributarios."
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="DimGray"/>
                            <Button Content="Importar DTE desde JSON"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirCargaDte_Click"/>
                            <Button Content="Validar DTE"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirValidacionFiscal_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ModuleCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Contabilidad"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Genera partidas y libros desde los DTE."
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="DimGray"/>
                            <Button Content="Catálogo de cuentas"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirCatalogoCuentas_Click"/>
                            <Button Content="Reglas contables (avanzado)"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirReglasContables_Click"/>
                            <Button Content="Libros Diario y Mayor"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirLibrosContables_Click"/>
                            <Button Content="Registrar partida manual"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirPartidasContables_Click"/>
                            <Button Content="DTE a libros contables"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirContabilizacionAutomatica_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource ModuleCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="Libros fiscales"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Libros de ventas y compras, exportaciones y auditoría."
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="DimGray"/>
                            <Button Content="Libros de ventas y compras"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirLibroIva_Click"/>
                            <Button Content="Generar exportación fiscal"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirExportacionFiscal_Click"/>
                            <Button Content="Bitácora de auditoría"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="AbrirBitacoraAuditoria_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
          
<UserControl x:Class="SistemaContableDTE.Views.CargaDteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:CargaDteViewModel/>
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,20">
            <TextBlock Text="Carga de Documentos Tributarios Electrónicos"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Content="Volver al panel"
                    Width="170"
                    Height="32"
                    HorizontalAlignment="Right"
                    Click="VolverAlPanelPrincipal_Click"/>
        </Grid>

        <GroupBox Grid.Row="1"
                  Header="Clientes a quienes se lleva la contabilidad"
                  Margin="0,0,0,15">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Nombre del cliente"/>
                    <TextBox Text="{Binding NombreCliente,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="NIT"/>
                    <TextBox Text="{Binding NitCliente,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,10">
                    <TextBlock Text="NRC (opcional)"/>
                    <TextBox Text="{Binding NrcCliente,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="3"
                        Content="Registrar cliente"
                        Height="30"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,10"
                        Command="{Binding AgregarClienteCommand}"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Margin="0,0,12,0">
                    <TextBlock Text="Cliente para importar o asignar el DTE seleccionado (si no eliges uno, se intenta detectar por NIT/NRC)"/>
                    <ComboBox ItemsSource="{Binding Clientes}"
                              SelectedItem="{Binding ClienteSeleccionado}"
                              DisplayMemberPath="Etiqueta"
                              Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="3"
                        Content="Asignar al DTE"
                        Height="30"
                        VerticalAlignment="Bottom"
                        Command="{Binding AsignarClienteCommand}"/>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <TextBlock Text="Para los JSON de prueba: "
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Content="El cliente es el emisor"
                            Height="30"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Command="{Binding RegistrarEmisorComoClienteCommand}"/>
                    <Button Content="El cliente es el receptor"
                            Height="30"
                            Padding="10,0"
                            Command="{Binding RegistrarReceptorComoClienteCommand}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="Importar archivo JSON"
                  Margin="0,0,0,15">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ArchivoSeleccionado}"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="1"
                        Content="Seleccionar JSON"
                        Height="30"
                        Margin="12,0"
                        Click="SeleccionarArchivo_Click"/>

                <Button Grid.Column="2"
                        Content="Actualizar lista"
                        Height="30"
                        Command="{Binding CargarCommand}"/>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="3"
                   Text="{Binding Mensaje}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Top"
                    Content="Eliminar DTE seleccionado"
                    Width="200"
                    Height="30"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,8"
                    Command="{Binding EliminarCommand}" />
            <DataGrid ItemsSource="{Binding Documentos}"
                      SelectedItem="{Binding DocumentoSeleccionado,
                                             Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding FechaEmision,
                                                      StringFormat=d}"
                                    Width="100"/>
                <DataGridTextColumn Header="Tipo DTE"
                                    Binding="{Binding TipoDte}"
                                    Width="90"/>
                <DataGridTextColumn Header="Código de generación"
                                    Binding="{Binding CodigoGeneracion}"
                                    Width="*"/>
                <DataGridTextColumn Header="Número de control"
                                    Binding="{Binding NumeroControl}"
                                    Width="180"/>
                <DataGridTextColumn Header="Emisor del JSON"
                                    Binding="{Binding EmisorDescripcion, Mode=OneWay}"
                                    Width="220"/>
                <DataGridTextColumn Header="Receptor del JSON"
                                    Binding="{Binding ReceptorDescripcion, Mode=OneWay}"
                                    Width="220"/>
                <DataGridTextColumn Header="Rol empresa"
                                    Binding="{Binding RolEmpresa}"
                                    Width="130"/>
                <DataGridTextColumn Header="Clasificación"
                                    Binding="{Binding OperacionContableDescripcion, Mode=OneWay}"
                                    Width="150"/>
                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding ClienteContable.Nombre, Mode=OneWay}"
                                    Width="180"/>
                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Estado}"
                                    Width="150"/>
            </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
<UserControl x:Class="SistemaContableDTE.Views.ConfiguracionInicialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:ConfiguracionInicialViewModel />
    </UserControl.DataContext>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfiguracionRealizada}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid Margin="30" MaxWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Configuración inicial"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Registra la empresa, el usuario administrador y el período contable."
                           Margin="0,6,0,0"
                           Foreground="DimGray" />
            </StackPanel>

            <GroupBox Grid.Row="1" Header="Empresa" Margin="0,0,0,15">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Razón social *" />
                        <TextBox Text="{Binding NombreRazonSocial, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                        <TextBlock Text="Nombre comercial" />
                        <TextBox Text="{Binding NombreComercial, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="NIT *" />
                        <TextBox Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                        <TextBlock Text="NRC" />
                        <TextBox Text="{Binding Nrc, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Código de actividad" />
                        <TextBox Text="{Binding CodigoActividad, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                        <TextBlock Text="Descripción de actividad" />
                        <TextBox Text="{Binding DescripcionActividad, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Departamento" />
                        <TextBox Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,10">
                        <TextBlock Text="Municipio" />
                        <TextBox Text="{Binding Municipio, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Correo electrónico" />
                        <TextBox Text="{Binding CorreoEmpresa, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Teléfono" />
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Administrador" Margin="0,0,0,15">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Nombre completo *" />
                        <TextBox Text="{Binding NombreAdministrador, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Correo electrónico *" />
                        <TextBox Text="{Binding CorreoAdministrador, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2"
                                Margin="0,55,0,0">
                        <TextBlock Text="Contraseña *" />
                        <PasswordBox x:Name="ContrasenaAdministrador" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Período contable" Margin="0,0,0,15">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Nombre del período *" />
                        <TextBox Text="{Binding NombrePeriodo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="Fecha de inicio" />
                        <DatePicker SelectedDate="{Binding FechaInicioPeriodo}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Fecha de finalización" />
                        <DatePicker SelectedDate="{Binding FechaFinPeriodo}" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="4">
                <TextBlock Text="{Binding Mensaje}"
                           Foreground="DarkRed"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <Button Content="Guardar configuración"
                        Width="210"
                        Height="35"
                        HorizontalAlignment="Left"
                        Click="Guardar_Click" />
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Margin="30"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfiguracionRealizada}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Configuración completada"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="DarkGreen" />
            <TextBlock Text="{Binding Mensaje}"
                       Margin="0,10,0,0"
                       FontSize="16"
                       TextWrapping="Wrap" />
            <TextBlock Text="La configuración ya está guardada. Esta versión del proyecto todavía no incluye una pantalla principal ni módulos para continuar."
                       Margin="0,8,0,0"
                       Foreground="DimGray"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
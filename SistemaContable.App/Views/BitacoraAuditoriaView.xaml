<UserControl x:Class="SistemaContableDTE.Views.BitacoraAuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels"
             MinWidth="480">

    <UserControl.DataContext>
        <vm:BitacoraAuditoriaViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Tarjetas: mismo lenguaje visual que el resto del sistema. -->
        <Style x:Key="AuditCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#17365D"
                                      BlurRadius="14"
                                      ShadowDepth="2"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuditLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#243B53"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="AuditTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AuditDateStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Base reutilizable para botones, sin alterar sus comandos ni eventos. -->
        <Style x:Key="AuditButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#285AA2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#285AA2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.83"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuditSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AuditButtonStyle}">
            <Setter Property="Background" Value="#EAF1FB"/>
            <Setter Property="Foreground" Value="#214D85"/>
            <Setter Property="BorderBrush" Value="#D3E2F5"/>
        </Style>

        <Style x:Key="AuditBackButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AuditButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#214D85"/>
            <Setter Property="BorderBrush" Value="#C9D8EA"/>
        </Style>

        <Style x:Key="AuditHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1FB"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#D8E4F1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="AuditRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Foreground" Value="#243B53"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFA"/>
                    <Setter Property="Foreground" Value="#17365D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- El JSON largo sigue accesible completo al pasar el cursor. -->
        <Style x:Key="AuditValuesTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="ToolTip" Value="{Binding ValoresNuevos}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="26,24,26,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Bitácora de auditoría"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Consultá las acciones realizadas dentro de la empresa."
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#667A97"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Volver al panel"
                    Width="150"
                    VerticalAlignment="Top"
                    Style="{StaticResource AuditBackButtonStyle}"
                    Click="Volver_Click"/>
        </Grid>

        <!-- Filtros: WrapPanel adapta la disposición sin forzar ancho horizontal. -->
        <Border Grid.Row="1"
                Margin="26,0,26,16"
                Style="{StaticResource AuditCardStyle}">
            <StackPanel>
                <TextBlock Text="Filtrar registros"
                           Foreground="#214F7A"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>

                <WrapPanel Orientation="Horizontal">
                    <StackPanel Width="215" Margin="0,0,14,12">
                        <TextBlock Text="Entidad" Style="{StaticResource AuditLabelStyle}"/>
                        <TextBox Text="{Binding EntidadFiltro, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AuditTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Width="215" Margin="0,0,14,12">
                        <TextBlock Text="Acción" Style="{StaticResource AuditLabelStyle}"/>
                        <TextBox Text="{Binding AccionFiltro, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AuditTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Width="160" Margin="0,0,14,12">
                        <TextBlock Text="Desde" Style="{StaticResource AuditLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FechaDesde}"
                                    Style="{StaticResource AuditDateStyle}"/>
                    </StackPanel>

                    <StackPanel Width="160" Margin="0,0,0,12">
                        <TextBlock Text="Hasta" Style="{StaticResource AuditLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FechaHasta}"
                                    Style="{StaticResource AuditDateStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0">
                    <Button Content="Buscar"
                            Width="122"
                            Margin="0,0,10,0"
                            Style="{StaticResource AuditButtonStyle}"
                            Command="{Binding CargarCommand}"/>
                    <Button Content="Limpiar"
                            Width="122"
                            Style="{StaticResource AuditSecondaryButtonStyle}"
                            Command="{Binding LimpiarFiltrosCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Mensajes: ocultos si el ViewModel no tiene texto. -->
        <Border Grid.Row="2"
                Margin="26,0,26,14"
                Background="#EFF6FF"
                BorderBrush="#D3E2F5"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mensaje}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mensaje}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensaje}"
                       Foreground="#214D85"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Tabla: su barra horizontal es independiente de toda la pantalla. -->
        <Border Grid.Row="3"
                Margin="26,0,26,26"
                Style="{StaticResource AuditCardStyle}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Historial de acciones"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#214F7A"
                           Margin="2,0,0,14"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Registros}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          Background="White"
                          ColumnHeaderStyle="{StaticResource AuditHeaderStyle}"
                          RowStyle="{StaticResource AuditRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding FechaHora}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Usuario"
                                            Binding="{Binding Usuario.Nombre}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Entidad"
                                            Binding="{Binding Entidad}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding IdEntidad}"
                                            Width="75"/>
                        <DataGridTextColumn Header="Acción"
                                            Binding="{Binding Accion}"
                                            Width="250"/>
                        <DataGridTextColumn Header="Valores nuevos"
                                            Binding="{Binding ValoresNuevos}"
                                            ElementStyle="{StaticResource AuditValuesTextStyle}"
                                            Width="540"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

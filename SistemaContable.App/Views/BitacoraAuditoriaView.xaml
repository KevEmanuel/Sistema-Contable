<UserControl x:Class="SistemaContableDTE.Views.BitacoraAuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SistemaContableDTE.ViewModels">

    <UserControl.DataContext>
        <vm:BitacoraAuditoriaViewModel />
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Bitácora de auditoría"
                       FontSize="26"
                       FontWeight="Bold" />

            <TextBlock Text="Consulta las acciones realizadas dentro de la empresa."
                       Margin="0,6,0,0"
                       Foreground="DimGray" />
        </StackPanel>

        <GroupBox Grid.Row="1"
                  Header="Filtros"
                  Margin="0,0,0,15">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Entidad" />
                    <TextBox Text="{Binding EntidadFiltro,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Acción" />
                    <TextBox Text="{Binding AccionFiltro,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Desde" />
                    <DatePicker SelectedDate="{Binding FechaDesde}"
                                Height="28"
                                Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Hasta" />
                    <DatePicker SelectedDate="{Binding FechaHasta}"
                                Height="28"
                                Margin="0,5,0,0" />
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Buscar"
                        Height="28"
                        Margin="0,22,10,0"
                        Command="{Binding CargarCommand}" />

                <Button Grid.Column="5"
                        Content="Limpiar"
                        Height="28"
                        Margin="0,22,0,0"
                        Command="{Binding LimpiarFiltrosCommand}" />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="2"
                   Text="{Binding Mensaje}"
                   Foreground="DarkRed"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding Registros}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding FechaHora}"
                                        Width="150" />
                    <DataGridTextColumn Header="Usuario"
                                        Binding="{Binding Usuario.Nombre}"
                                        Width="180" />
                    <DataGridTextColumn Header="Entidad"
                                        Binding="{Binding Entidad}"
                                        Width="140" />
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding IdEntidad}"
                                        Width="90" />
                    <DataGridTextColumn Header="Acción"
                                        Binding="{Binding Accion}"
                                        Width="180" />
                    <DataGridTextColumn Header="Valores nuevos"
                                        Binding="{Binding ValoresNuevos}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="1"
                    Content="Volver al panel principal"
                    Width="190"
                    Height="32"
                    HorizontalAlignment="Left"
                    Margin="0,15,0,0"
                    Click="Volver_Click" />
        </Grid>
    </Grid>
</UserControl>